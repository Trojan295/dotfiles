function kca
    kubectl $argv --all-namespaces
end

function kres
    kubectl set env $argv REFRESHED_AT=(date +%Y%m%d%H%M%S)
end

function kj --wraps kubectl
    kubectl $argv -o json | jq
end

function kjx --wraps kubectl
    kubectl $argv -o json | fx
end

function ky --wraps kubectl
    kubectl $argv -o yaml | yh
end
