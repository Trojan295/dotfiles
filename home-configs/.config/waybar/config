{
  "layer": "top",
  "position": "top",
  "height": 32,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "pulseaudio", "backlight",
    "battery", "tray", "custom/powermenu"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "1": "", "2": "", "3": "", "4": "", "5": "",
      "default": ""
    }
  },

  "clock": {
    "format": " {:%a %d %b  %H:%M}",
    "tooltip": false
  },

  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " muted",
    "on-click": "pavucontrol"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "backlight": {
  	"device": "intel_backlight",
  	"format": "{icon} {percent}%",
  	"format-icons": ["", ""]
  },

  "tray": {
    "icon-size": 16,
    "spacing": 5
  },

  "custom/powermenu": {
    "format": "⏻ ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml",
    "menu-actions": {
        "shutdown": "systemctl poweroff",
        "reboot": "systemctl reboot",
        "suspend": "systemctl hybrid-sleep"
    },
    "menu-classes": ["menu"]
  }
}

